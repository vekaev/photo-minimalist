<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.horizonleveler.cardwatcher</string>
	<key>BundleProgram</key>
	<string>Contents/Resources/card-watcher.sh</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.horizonleveler.HorizonLeveler</string>
	</array>
	<!-- A card mounting adds a folder to /Volumes; ejecting removes it (so a re-inserted card counts as new). -->
	<key>WatchPaths</key>
	<array>
		<string>/Volumes</string>
	</array>
	<key>StartOnMount</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
